---
import { navLinks } from "../data/navigation.ts";
import { site } from "../data/site.ts";
---

<header class="px-6 py-6 border-b border-slate-200">
    <div class="flex justify-between items-center">
        <a href="#inicio" class="text-xl font-bold text-brand-600"
            >{site.name}</a
        >

        <nav aria-label="Principal" class="hidden md:flex">
            {/* Menú escritorio */}
            <ul class="flex gap-6">
                {
                    navLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="hover:text-brand-700 transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <button
            type="button"
            id="menu-button"
            class="md:hidden p-2 rounded-md text-brand-600 hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-brand-600"
            aria-label="Menú"
            aria-expanded="false"
            aria-controls="mobile-menu"
        >
            <svg
                aria-hidden="true"
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
            >
                <path d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <nav aria-label="Menú móvil" id="mobile-menu" class="hidden md:hidden">
        {/* menu movil */}
        <ul>
            {
                navLinks.map((link) => (
                    <li>
                        <a href={link.href} class="block py-3">
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    const button = document.getElementById("menu-button");
    const mobileMenu = document.getElementById("mobile-menu");

    if (button && mobileMenu) {
        button.addEventListener("click", () => {
            const isCollapsed = mobileMenu.classList.toggle("hidden");
            button.setAttribute("aria-expanded", String(!isCollapsed));
        });

        const links = mobileMenu.querySelectorAll("a");
        links.forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                button.setAttribute("aria-expanded", "false");
            });
        });
    }
</script>
